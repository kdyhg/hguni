APP_ENV=development
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
USE_MOCK_DATA=true
LOCAL_DATABASE_PATH=./data/hguni.db
PIN_PEPPER=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SOURCE_SCOPE=hguni-development
REAL_WRITES_ENABLED=false
BRIDGE_TOKEN_PEPPER=replace-with-a-different-random-value
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./config/google-service-account.json
